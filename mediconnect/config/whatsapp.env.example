# Copie este archivo como config/whatsapp.env (queda fuera de Git) y complete los valores.
# NUNCA pegue estos valores en chats, correos ni capturas de pantalla.
# En el servidor se cargan como variables de entorno (p. ej. EnvironmentFile de systemd).

WHATSAPP_ENABLED=true
# Una frase larga inventada por usted; la misma que escribirá en Meta al configurar el webhook.
WHATSAPP_VERIFY_TOKEN=
# «Clave secreta de la app» (App Secret) de la aplicación de Meta: firma cada webhook.
WHATSAPP_APP_SECRET=
# Token PERMANENTE de un usuario del sistema con acceso a la cuenta de WhatsApp (no el token temporal de 24 h).
WHATSAPP_TOKEN=
# Opcional. Versión de la API de Meta.
# WHATSAPP_API_VERSION=v21.0
