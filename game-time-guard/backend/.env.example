# Copia este archivo a .env solo si vas a correr el backend en tu propia
# maquina para probar. En Cloud Run estas variables se configuran como
# variables de entorno del servicio, no con un archivo .env.

# Puerto donde escucha el servidor. Cloud Run lo define solo (PORT=8080).
PORT=3000

# Clave de adulto inicial. Si no la definis, el servidor genera una al azar
# y la muestra UNA SOLA VEZ en los logs la primera vez que arranca.
# ADMIN_INITIAL_PASSWORD=elegi-una-clave-fuerte

# Para correr esto en tu computadora (no en Cloud Run) contra Firestore real,
# hace falta autenticarte antes con:
#   gcloud auth application-default login
#   gcloud config set project TU_PROYECTO_DE_GOOGLE_CLOUD
