# Copia este archivo a .env (o configuralo como variables de entorno en tu hosting).

# Puerto donde escucha el servidor.
PORT=3000

# Carpeta donde se guarda la base de datos SQLite. En Render, usa un "Persistent Disk"
# montado en esta ruta para que los datos no se pierdan en cada deploy.
DATA_DIR=./data

# Clave de adulto inicial. Si no la definis, el servidor genera una al azar
# y la muestra UNA SOLA VEZ en los logs la primera vez que arranca.
# ADMIN_INITIAL_PASSWORD=elegi-una-clave-fuerte
